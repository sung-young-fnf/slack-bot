# Notion — 두 가지 경로 중 하나 선택
# (A) Orbit MCP 경유 — 사내 Orbit 구독자라면 권장.
#     Orbit 페이지의 "API Key 인증" 섹션에서 발급받아 ORBIT_MCP_TOKEN에 입력.
ORBIT_MCP_URL=https://orbit-mcp-api.fnf.co.kr/api/projects/<pid>/subscriptions/<sid>/mcp
ORBIT_MCP_TOKEN=orbit-api-key-here
# (B) 직접 Notion API 경유 — 본인 Internal Integration 토큰 필요
NOTION_TOKEN=
NOTION_ROW_TITLE=Castle / castle.alter

# GitHub
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_USERNAME=your-github-username

